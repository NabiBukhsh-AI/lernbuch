# Postgres. Neon in production (keep ?sslmode=require); for local development
# `docker compose up -d` and use the localhost URL below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lernbuch
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/lernbuch?sslmode=require

# openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# The single admin account, created or updated by `pnpm seed:admin`.
# Only needed where you run that script, not on the server.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=

# Optional: a folder of lesson .md files for `pnpm ingest`. Lessons can also be
# uploaded from the admin panel instead.
CONTENT_DIR=./content/lessons

NEXT_PUBLIC_APP_NAME=Lernbuch
